        "jsCode": "let bajas = new Set();\ntry {\n  for (const r of $('Get Bajas').all()) {\n    const e = String((r.json && (r.json.Email ?? r.json.email)) || '').toLowerCase().trim();\n    if (e) bajas.add(e);\n  }\n} catch (err) { /* fail-open */ }\nreturn $input.all().filter(it => {\n  const email = String(it.json['Email encontrado'] || '').toLowerCase().trim();\n  return !email || !bajas.has(email);\n});"
