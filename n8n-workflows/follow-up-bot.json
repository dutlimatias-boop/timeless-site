    {
      "id": "node-code-filter",
      "name": "Code - Filtrar y calcular dias",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 0],
      "parameters": {
        "jsCode": "function parseDate(dateStr) {\n  if (!dateStr) return new Date();\n  const iso = new Date(dateStr);\n  if (!isNaN(iso.getTime())) return iso;\n  const parts = String(dateStr).split('/');\n  if (parts.length === 3) {\n    return new Date(parseInt(parts[2]), parseInt(parts[1]) - 1, parseInt(parts[0]));\n  }\n  return new Date();\n}\n\nconst validDays = [3, 7, 14, 30];\n\nreturn $input.all()\n  .filter(item => {\n    const estado = (item.json['Estado'] || '').trim();\n    return estado !== 'Descartado' && estado !== 'Pipeline';\n  })\n  .map(item => {\n    const fechaEnvio = parseDate(item.json['Fecha envio'] || item.json['Fecha envio'] || '');\n    const dias = Math.floor((Date.now() - fechaEnvio.getTime()) / 86400000);\n    return { json: { ...item.json, dias_desde_envio: dias } };\n  })\n  .filter(item => validDays.includes(item.json.dias_desde_envio));"
      }
    },
