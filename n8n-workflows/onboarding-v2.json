    {
      "parameters": {
        "jsCode": "const _raw = $('POST /onboarding-hotel').first().json;\nconst data = (_raw.body && typeof _raw.body === 'object') ? _raw.body : _raw;\n\nif (!data.job_id) throw new Error('Campo requerido faltante: job_id');\nif (!data.email) throw new Error('Campo requerido faltante: email');\nif (!data.business_name) throw new Error('Campo requerido faltante: business_name');\n\nconst job_id = data.job_id;\nconst business_id = data.email.replace(/[@.]/g, '_');\n\nconst chunks = [];\n\nconst identity = [\n  `Negocio: ${data.business_name}`,\n  `Tipo: ${data.business_type}`,\n  `Dirección: ${data.address}`,\n  `Sitio web: ${data.website}`,\n  data.business_description ? `Descripción: ${data.business_description}` : ''\n].filter(Boolean).join('\\n');\nchunks.push({ text: identity, category: 'identidad' });\n\nif (data.services && data.services.length > 0) {\n  data.services.forEach(svc => {\n    if (!svc.name) return;\n    const parts = [`Servicio: ${svc.name}`];\n    if (svc.price)       parts.push(`Precio: $${svc.price}`);\n    if (svc.description) parts.push(`Descripción: ${svc.description}`);\n    if (svc.extra)       parts.push(`Duración/Capacidad: ${svc.extra}`);\n    chunks.push({ text: parts.join('\\n'), category: 'servicio' });\n  });\n}\n\nif (data.schedule) {\n  const horario = [\n    `Horario de apertura: ${data.schedule.open}`,\n    `Horario de cierre: ${data.schedule.close}`,\n    data.schedule.days ? `Días: ${data.schedule.days}` : ''\n  ].filter(Boolean).join('\\n');\n  chunks.push({ text: horario, category: 'horario' });\n}\n\nif (data.amenities && data.amenities.length > 0) {\n  const amenText = `Características disponibles: ${data.amenities.join(', ')}`\n    + (data.amenities_other ? `, ${data.amenities_other}` : '');\n  chunks.push({ text: amenText, category: 'amenities' });\n}\n\nif (data.cancellation_policy) {\n  chunks.push({ text: `Política de cancelación: ${data.cancellation_policy}`, category: 'politica' });\n}\nif (data.other_policies) {\n  chunks.push({ text: `Otras políticas: ${data.other_policies}`, category: 'politica' });\n}\n\nif (data.faq && data.faq.length > 0) {\n  data.faq.forEach(item => {\n    if (!item.question && !item.answer) return;\n    chunks.push({ text: `Pregunta: ${item.question}\\nRespuesta: ${item.answer}`, category: 'faq' });\n  });\n}\n\nif (data.additional_info) {\n  chunks.push({ text: `Información adicional: ${data.additional_info}`, category: 'adicional' });\n}\n\nreturn chunks.map(chunk => ({\n  json: {\n    job_id,\n    business_id,\n    business_name: data.business_name,\n    email: data.email,\n    text: chunk.text,\n    metadata: JSON.stringify({ business_id, category: chunk.category, source: 'onboarding' })\n  }\n}));"
      },
