        "jsCode": "const jobId = $('GET /onboarding-status').first().json.query.job_id;\nconst rows = $input.all();\nconst row = rows.find(r => r.json.job_id === jobId);\n\nif (!row) {\n  return [{ json: {\n    found: false,\n    job_id: jobId,\n    steps: { received: 'pending', ingestion: 'pending', smoketest: 'pending', email: 'pending' }\n  }}];\n}\n\nreturn [{ json: {\n  found: true,\n  job_id: row.json.job_id,\n  steps: {\n    received:  row.json.received  || 'pending',\n    ingestion: row.json.ingestion || 'pending',\n    smoketest: row.json.smoketest || 'pending',\n    email:     row.json.email_sent || 'pending'\n  }\n}}];"
      },
