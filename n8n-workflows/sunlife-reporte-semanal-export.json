      "parameters": {
        "jsCode": "const rows = $input.all();\nconst ahora = new Date();\n\nfunction parseFecha(fechaStr) {\n  if (!fechaStr) return null;\n  const [dia, mes, anio] = fechaStr.split('/');\n  return new Date(anio, mes - 1, dia);\n}\n\nconst estaSemana = [];\nconst semanaAnterior = [];\n\nfor (const row of rows) {\n  const fecha = parseFecha(row.json.fecha);\n  if (!fecha) continue;\n  const diffDias = (ahora - fecha) / (1000 * 60 * 60 * 24);\n  if (diffDias <= 7) estaSemana.push(row.json);\n  else if (diffDias <= 14) semanaAnterior.push(row.json);\n}\n\nconst total = estaSemana.length;\nconst totalAnterior = semanaAnterior.length;\nconst cambioTotal = totalAnterior > 0 ? (((total - totalAnterior) / totalAnterior) * 100).toFixed(0) : 0;\nconst flechaTotal = cambioTotal > 0 ? `↑ +${cambioTotal}% vs previous week` : cambioTotal < 0 ? `↓ ${cambioTotal}% vs previous week` : '= same as previous week';\nconst colorFlecha = cambioTotal > 0 ? '#2d8a4e' : cambioTotal < 0 ? '#e53e3e' : '#666';\n\nlet reservados = 0;\nlet interesados = 0;\nlet enProceso = 0;\n\nfor (const row of estaSemana) {\n  const estado = (row.estado || '').toLowerCase();\n  const intencion = (row.intencion || '').toLowerCase();\n  if (estado === 'reservado' || intencion.includes('reserva')) reservados++;\n  else if (estado === 'interesado' || intencion.includes('interes')) interesados++;\n  else if (estado === 'en_proceso' || intencion.includes('proceso')) enProceso++;\n}\n\nconst tasaConversion = total > 0 ? ((reservados / total) * 100).toFixed(1) : '0.0';\nconst reservadosAnterior = semanaAnterior.filter(r => (r.estado||'').toLowerCase() === 'reservado').length;\nconst tasaAnterior = totalAnterior > 0 ? ((reservadosAnterior / totalAnterior) * 100).toFixed(1) : '0.0';\n\nconst keywords = {\n  'pricing / rates':  ['price', 'cost', 'how much', 'rate', 'fee'],\n  'availability':     ['available', 'availability', 'date', 'free', 'vacancy'],\n  'booking':          ['book', 'reserve', 'reservation', 'check-in', 'check-out'],\n  'amenities':        ['pool', 'wifi', 'breakfast', 'parking', 'kitchen'],\n  'location':         ['where', 'location', 'directions', 'beach', 'far']\n};\n\nconst temasConteo = {};\nfor (const row of estaSemana) {\n  const consulta = (row.consulta || '').toLowerCase();\n  for (const [tema, palabras] of Object.entries(keywords)) {\n    if (palabras.some(p => consulta.includes(p))) {\n      temasConteo[tema] = (temasConteo[tema] || 0) + 1;\n    }\n  }\n}\n\nconst topTemas = Object.entries(temasConteo)\n  .sort((a, b) => b[1] - a[1])\n  .slice(0, 3)\n  .map(([k, v], i) => `<tr><td style=\"padding:8px 0;color:#0a1628;font-size:14px;\">${i+1}. ${k}</td><td style=\"padding:8px 0;text-align:right;font-weight:bold;color:#0a1628;\">${v} queries</td></tr>`)\n  .join('');\n\nconst canales = {};\nfor (const row of estaSemana) {\n  const canal = row.canal || 'Unknown';\n  canales[canal] = (canales[canal] || 0) + 1;\n}\nconst canalesStr = Object.entries(canales)\n  .map(([k, v]) => `<tr><td style=\"padding:6px 0;color:#333;font-size:14px;\">${k}</td><td style=\"padding:6px 0;text-align:right;font-weight:bold;color:#0a1628;\">${v}</td></tr>`)\n  .join('');\n\nconst valorEstimado = reservados * 150 * 4;\n\nconst fechaInicio = new Date(ahora); fechaInicio.setDate(ahora.getDate() - 7);\nconst formatFecha = (d) => d.toLocaleDateString('en-US', {day:'2-digit', month:'2-digit', year:'numeric'});\n\nreturn [{\n  json: {\n    total,\n    totalAnterior,\n    flechaTotal,\n    colorFlecha,\n    interesados,\n    reservados,\n    enProceso,\n    tasaConversion,\n    tasaAnterior,\n    topTemas: topTemas || '<tr><td colspan=\"2\" style=\"color:#666;font-size:13px;\">Not enough data this week</td></tr>',\n    canalesStr: canalesStr || '<tr><td colspan=\"2\" style=\"color:#666;font-size:13px;\">No data</td></tr>',\n    valorEstimado: `USD ${valorEstimado.toLocaleString()}`,\n    semana: `${formatFecha(fechaInicio)} – ${formatFecha(ahora)}`\n  }\n}];"
      },
