          "subject": "Reporte Semanal - Sun Life Beach Hotel",
          "message": "=<!DOCTYPE html>\n<html>\n<body style=\"margin:0;padding:0;background:#f4f4f4;font-family:Georgia,serif;\">\n<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f4f4f4;padding:40px 0;\">\n  <tr><td align=\"center\">\n  <table width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#ffffff;border-radius:12px;overflow:hidden;box-shadow:0 4px 20px rgba(0,0,0,0.1);\">\n\n    <tr>\n      <td style=\"background:#0a1628;padding:40px;text-align:center;\">\n        <h1 style=\"color:#C9A84C;margin:0;font-size:28px;letter-spacing:2px;\">TIMELESS</h1>\n        <p style=\"color:#ffffff;margin:8px 0 0;font-size:13px;letter-spacing:1px;\">REPORTE SEMANAL DE RENDIMIENTO</p>\n      </td>\n    </tr>\n\n    <tr>\n      <td style=\"background:#C9A84C;padding:16px 40px;text-align:center;\">\n        <p style=\"margin:0;color:#0a1628;font-size:16px;font-weight:bold;\">🏨 Hotel Patagonia — Bariloche</p>\n        <p style=\"margin:4px 0 0;color:#0a1628;font-size:13px;\">Semana: {{ $json.semana }}</p>\n      </td>\n    </tr>\n\n    <tr>\n      <td style=\"padding:40px;\">\n\n        <!-- RESUMEN -->\n        <h2 style=\"color:#0a1628;font-size:15px;margin:0 0 20px;text-transform:uppercase;letter-spacing:1px;border-bottom:2px solid #C9A84C;padding-bottom:8px;\">Resumen de la semana</h2>\n        <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n          <tr>\n            <td width=\"30%\" style=\"text-align:center;padding:20px;background:#f9f9f9;border-radius:8px;\">\n              <p style=\"margin:0;font-size:36px;font-weight:bold;color:#0a1628;\">{{ $json.total }}</p>\n              <p style=\"margin:6px 0 0;font-size:11px;color:#666;text-transform:uppercase;\">Consultas</p>\n            </td>\n            <td width=\"4%\"></td>\n            <td width=\"30%\" style=\"text-align:center;padding:20px;background:#f9f9f9;border-radius:8px;\">\n              <p style=\"margin:0;font-size:36px;font-weight:bold;color:#C9A84C;\">{{ $json.interesados }}</p>\n              <p style=\"margin:6px 0 0;font-size:11px;color:#666;text-transform:uppercase;\">Interesados</p>\n            </td>\n            <td width=\"4%\"></td>\n            <td width=\"30%\" style=\"text-align:center;padding:20px;background:#f9f9f9;border-radius:8px;\">\n              <p style=\"margin:0;font-size:36px;font-weight:bold;color:#2d8a4e;\">{{ $json.reservados }}</p>\n              <p style=\"margin:6px 0 0;font-size:11px;color:#666;text-transform:uppercase;\">Reservados</p>\n            </td>\n          </tr>\n        </table>\n        <p style=\"text-align:center;margin:12px 0 0;font-size:13px;font-weight:bold;color:{{ $json.colorFlecha }};\">{{ $json.flechaTotal }}</p>\n\n        <!-- CONVERSIÓN Y VALOR -->\n        <h2 style=\"color:#0a1628;font-size:15px;margin:32px 0 16px;text-transform:uppercase;letter-spacing:1px;border-bottom:2px solid #C9A84C;padding-bottom:8px;\">Conversión y valor generado</h2>\n        <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n          <tr>\n            <td width=\"47%\" style=\"text-align:center;padding:20px;background:#f9f9f9;border-radius:8px;\">\n              <p style=\"margin:0;font-size:32px;font-weight:bold;color:#0a1628;\">{{ $json.tasaConversion }}%</p>\n              <p style=\"margin:6px 0 0;font-size:11px;color:#666;text-transform:uppercase;\">Tasa de conversión</p>\n              <p style=\"margin:6px 0 0;font-size:11px;color:#999;\">Semana anterior: {{ $json.tasaAnterior }}%</p>\n            </td>\n            <td width=\"6%\"></td>\n            <td width=\"47%\" style=\"text-align:center;padding:20px;background:#0a1628;border-radius:8px;\">\n              <p style=\"margin:0;font-size:28px;font-weight:bold;color:#C9A84C;\">{{ $json.valorEstimado }}</p>\n              <p style=\"margin:6px 0 0;font-size:11px;color:#ffffff;text-transform:uppercase;\">Valor estimado generado</p>\n              <p style=\"margin:6px 0 0;font-size:10px;color:#999;\">Basado en {{ $json.reservados }} reservas × USD 240 prom.</p>\n            </td>\n          </tr>\n        </table>\n\n        <!-- TOP TEMAS -->\n        <h2 style=\"color:#0a1628;font-size:15px;margin:32px 0 16px;text-transform:uppercase;letter-spacing:1px;border-bottom:2px solid #C9A84C;padding-bottom:8px;\">🔥 Temas más consultados</h2>\n        <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f9f9f9;border-radius:8px;padding:16px;\">\n          <tr><td style=\"padding:16px;\">\n            <table width=\"100%\">\n              {{ $json.topTemas }}\n            </table>\n          </td></tr>\n        </table>\n\n        <!-- CANALES -->\n        <h2 style=\"color:#0a1628;font-size:15px;margin:32px 0 16px;text-transform:uppercase;letter-spacing:1px;border-bottom:2px solid #C9A84C;padding-bottom:8px;\">Canal de contacto</h2>\n        <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f9f9f9;border-radius:8px;\">\n          <tr><td style=\"padding:16px;\">\n            <table width=\"100%\">\n              {{ $json.canalesStr }}\n            </table>\n          </td></tr>\n        </table>\n\n        <!-- SEGUIMIENTO -->\n        <h2 style=\"color:#0a1628;font-size:15px;margin:32px 0 16px;text-transform:uppercase;letter-spacing:1px;border-bottom:2px solid #C9A84C;padding-bottom:8px;\">Estado de seguimiento</h2>\n        <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n          <tr>\n            <td width=\"30%\" style=\"text-align:center;padding:16px;background:#f9f9f9;border-radius:8px;\">\n              <p style=\"margin:0;font-size:28px;font-weight:bold;color:#C9A84C;\">{{ $json.interesados }}</p>\n              <p style=\"margin:6px 0 0;font-size:11px;color:#666;text-transform:uppercase;\">Interesados</p>\n            </td>\n            <td width=\"4%\"></td>\n            <td width=\"30%\" style=\"text-align:center;padding:16px;background:#f9f9f9;border-radius:8px;\">\n              <p style=\"margin:0;font-size:28px;font-weight:bold;color:#0a1628;\">{{ $json.enProceso }}</p>\n              <p style=\"margin:6px 0 0;font-size:11px;color:#666;text-transform:uppercase;\">En proceso</p>\n            </td>\n            <td width=\"4%\"></td>\n            <td width=\"30%\" style=\"text-align:center;padding:16px;background:#f9f9f9;border-radius:8px;\">\n              <p style=\"margin:0;font-size:28px;font-weight:bold;color:#2d8a4e;\">{{ $json.reservados }}</p>\n              <p style=\"margin:6px 0 0;font-size:11px;color:#666;text-transform:uppercase;\">Reservados</p>\n            </td>\n          </tr>\n        </table>\n\n      </td>\n    </tr>\n\n    <tr>\n      <td style=\"background:#0a1628;padding:24px;text-align:center;\">\n        <p style=\"margin:0;color:#C9A84C;font-size:12px;letter-spacing:1px;\">Generado automáticamente por TIMELESS ✨</p>\n        <p style=\"margin:8px 0 0;color:#666;font-size:11px;\">Este reporte se genera todos los lunes a las 8:00am</p>\n      </td>\n    </tr>\n\n  </table>\n  </td></tr>\n</table>\n</body>\n</html>",
